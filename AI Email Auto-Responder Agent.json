    {
      "parameters": {
        "jsCode": "// 1. Extract the stringified JSON from Groq's response\nconst rawContent = $input.item.json.choices[0].message.content;\n\ntry {\n  // 2. Convert string to an actual usable JSON object\n  const parsedData = JSON.parse(rawContent);\n  \n  // 3. Output the clean data\n  return [{ json: parsedData }];\n\n} catch (error) {\n  // FALLBACK: If the LLM ever hallucinates non-JSON, don't crash the system.\n  return [{\n    json: {\n      category: \"General\",\n      urgency: \"Low\",\n      short_summary: \"Parsing failed\",\n      response: \"Thank you for reaching out. We have received your message and will review it shortly.\"\n    }\n  }];\n}"
      },
